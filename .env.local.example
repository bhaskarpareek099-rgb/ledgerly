# ==============================================================================
# Ledgerly Environment Variables Example Template
# Copy this file to .env.local for local development, or add to Vercel Environment Variables.
# NEVER commit your actual .env or .env.local files containing real secrets!
# ==============================================================================

# Server Configuration (optional)
PORT=3000

# ------------------------------------------------------------------------------
# Firebase Web SDK Configuration (Client-Side)
# Obtain from: Firebase Console > Project settings > General > Your apps > Web app
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# ------------------------------------------------------------------------------
# Firebase Admin SDK Configuration (Server-Side)
# Obtain from: Firebase Console > Project settings > Service accounts > Generate new private key
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# Google Gemini API Configuration (Smart Bill Scanner)
# Obtain from: Google AI Studio (https://aistudio.google.com/app/apikey)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
